{
  "outputDirectory": "dist",
  "functions": {
    "api/reports.js": {
      "includeFiles": "node_modules/pdfkit/js/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

